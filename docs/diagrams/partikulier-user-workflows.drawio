<mxfile host="app.diagrams.net" agent="partikulier-docs" version="24.0.0"><diagram id="page1" name="1. Actors &amp; use cases"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Partikulier — actors and use cases" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Moroccan real-estate portal reserved to private owners. Who can do what on the website (theme 'partikulier' + plugin 'partikulier-core' + Estatik + optional Polylang)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Partikulier website (WordPress)" style="rounded=0;html=1;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;fillColor=#ffffff;strokeColor=#999999;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1000" height="900" as="geometry"/></mxCell><mxCell id="c4" value="A. Public browsing (no account)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="470" height="330" as="geometry"/></mxCell><mxCell id="c5" value="B. Owner journey (deposit + owner space)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="470" height="330" as="geometry"/></mxCell><mxCell id="c6" value="C. Back-office (manage_options)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="470" height="490" as="geometry"/></mxCell><mxCell id="c7" value="D. Automation API (secret header X-Partikulier-Automation)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="810" y="480" width="470" height="490" as="geometry"/></mxCell><mxCell id="c8" value="Search &amp; filter listings&lt;br&gt;(Vendre/Louer, type, city, max price, sort)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c9" value="View a listing&lt;br&gt;/annonce/ville/quartier/slug" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c10" value="Switch language FR / EN / AR" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c11" value="Add / remove favourites ♥&lt;br&gt;(stored in browser)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c12" value="See 'Mes favoris' page" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c13" value="Contact owner via WhatsApp&lt;br&gt;(reference PK-123-ABCD)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c14" value="See closed listing (Vendu/Loué)&lt;br&gt;+ similar listings" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c15" value="Ask team for similar properties&lt;br&gt;(prefilled WhatsApp)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c16" value="Deposit a listing in 3 steps&lt;br&gt;(no account needed)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c17" value="Propose a missing city / district" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c18" value="Validate deposit by WhatsApp code&lt;br&gt;PK-&amp;lt;id&amp;gt;-XXXXXXX" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c19" value="Receive login + password&lt;br&gt;on WhatsApp (n8n)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c20" value="Log in → 'Mes annonces' dashboard&lt;br&gt;(views, favourites, KPIs)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c21" value="Edit a listing&lt;br&gt;(→ back to moderation)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c22" value="Deactivate with reason&lt;br&gt;(vendu / loué / avis / autre)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c23" value="Reactivate a deactivated listing" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c24" value="Approve / reject pending listings&lt;br&gt;(Valider les annonces)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c25" value="Mark WhatsApp code verified&lt;br&gt;(editor meta box)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c26" value="Regenerate &amp; resend password&lt;br&gt;('Nouveau mot de passe')" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c27" value="Moderate proposed places&lt;br&gt;(Lieux proposés)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c28" value="Import / reset cities &amp; districts" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c29" value="Configure deposit-form fields&lt;br&gt;per property type" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c30" value="Customize texts, WhatsApp number,&lt;br&gt;n8n webhook URL &amp; secret" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c31" value="Follow up WhatsApp leads&lt;br&gt;(status, note, CSV export)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c32" value="Grant / revoke premium&lt;br&gt;(public flag off by default)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c33" value="Run page diagnostic &amp; upgrade wizard" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c34" value="Trash / restore listings&lt;br&gt;(variants follow)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="835" width="210" height="52" as="geometry"/></mxCell><mxCell id="c35" value="Check /health endpoint" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="835" width="210" height="52" as="geometry"/></mxCell><mxCell id="c36" value="Receive 'listing_approved' webhook&lt;br&gt;→ send credentials" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c37" value="Catch-up: GET /approved-listings&lt;br&gt;(72 h, never a password)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c38" value="POST /contact-authorization&lt;br&gt;(max 2 distinct owners / day)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c39" value="POST /preferences&lt;br&gt;(budget, areas, layout)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c40" value="POST /consent&lt;br&gt;(similar listings, explicit OUI)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c41" value="POST /opt-out ('STOP')" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c42" value="POST /automation-event" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c43" value="POST /erase-lead (GDPR,&lt;br&gt;dedicated secret)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c44" value="Retention purge of leads&lt;br&gt;(365 days default)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c45" value="Anonymous favourite counts&lt;br&gt;(HMAC, 90 days)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c46" value="Visitor / Buyer&lt;br&gt;(anonymous)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="40" height="70" as="geometry"/></mxCell><mxCell id="c47" value="Search engines&lt;br&gt;(sitemap, JSON-LD)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="40" height="70" as="geometry"/></mxCell><mxCell id="c48" value="Administrator&lt;br&gt;(manage_options)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="690" width="40" height="70" as="geometry"/></mxCell><mxCell id="c49" value="Owner — Propriétaire&lt;br&gt;(anonymous depositor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="40" height="70" as="geometry"/></mxCell><mxCell id="c50" value="Registered owner&lt;br&gt;(contributor account)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="290" width="40" height="70" as="geometry"/></mxCell><mxCell id="c51" value="Real-estate agent /&lt;br&gt;agency (REFUSED)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1600" y="220" width="40" height="70" as="geometry"/></mxCell><mxCell id="c52" value="n8n orchestrator&lt;br&gt;(system actor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="c53" value="WhatsApp Business&lt;br&gt;Cloud (Meta)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1600" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="c54" value="API client&lt;br&gt;(logged-in editor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="820" width="40" height="70" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c46" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="crawl" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c47" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c48" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c49" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c50" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="refused" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c51" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="255"/><mxPoint x="1560" y="120"/><mxPoint x="1045" y="120"/></Array></mxGeometry></mxCell><mxCell id="c61" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c52" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c53" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="/listings, /favorites" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c54" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;User types (summary)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Visitor/Buyer&lt;/b&gt;: anonymous; browses, favourites (browser only), contacts via WhatsApp — never creates an account.&lt;br&gt;• &lt;b&gt;Owner (anonymous depositor)&lt;/b&gt;: deposits without account; a WordPress &lt;i&gt;contributor&lt;/i&gt; account is created silently.&lt;br&gt;• &lt;b&gt;Registered owner&lt;/b&gt;: same person after admin approval; receives login/password on WhatsApp, manages listings.&lt;br&gt;• &lt;b&gt;Agent/agency&lt;/b&gt;: explicitly refused (client-side and server-side) — the portal is owners-only, zero commission.&lt;br&gt;• &lt;b&gt;Administrator&lt;/b&gt;: moderates listings, places, leads, premium, settings.&lt;br&gt;• &lt;b&gt;System actors&lt;/b&gt;: n8n + WhatsApp Cloud API (secret header), REST API clients, search engines." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="1000" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Owner deposit &amp; approval"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow 1 — Owner deposits a listing, validates by WhatsApp, admin approves" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Page /deposer-une-annonce (templates/page-deposer-annonce.php → AJAX pk_submit_listing → Partikulier_Form::process) then Partikulier › Valider les annonces (Partikulier_Listing_Approval)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="2300" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Owner" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="40" height="230" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c5" value="Website (theme + plugin)" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="40" height="230" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c7" value="WhatsApp / n8n" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="40" height="230" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c9" value="Administrator" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="40" height="230" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c11" value="Clicks&lt;br&gt;'Déposer une annonce'" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="175" width="110" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Step 1&lt;/b&gt; — Who publishes?&lt;br&gt;Propriétaire / Agent immobilier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="175" width="170" height="60" as="geometry"/></mxCell><mxCell id="c13" value="Agent?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="80" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Refusal: 'Ce site est réservé aux propriétaires'&lt;br&gt;(JS + server: WP_Error role_agent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Step 1 (cont.) — Vendre / Louer,&lt;br&gt;property type, city + district&lt;br&gt;(autocomplete)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="180" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Place in&lt;br&gt;list?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="80" height="70" as="geometry"/></mxCell><mxCell id="c17" value="'Je ne trouve pas ma ville'&lt;br&gt;→ propose city / district" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="180" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Step 2&lt;/b&gt; — surface, rooms, bathrooms,&lt;br&gt;price, floor, garage, lift, terrace,&lt;br&gt;sunshine, extra fields*, photos (≤15, ≤10 MB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="165" width="220" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Step 3&lt;/b&gt; — preview, auto title (editable),&lt;br&gt;personal note, name, phone*, e-mail (opt.)&lt;br&gt;→ 'Valider avec WhatsApp'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="165" width="230" height="80" as="geometry"/></mxCell><mxCell id="c20" value="Server checks: nonce · idempotency key&lt;br&gt;(no double post) · rate limit (429) ·&lt;br&gt;field rules · WhatsApp number configured" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="340" width="230" height="75" as="geometry"/></mxCell><mxCell id="c21" value="Valid?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1380" y="340" width="80" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Error message (400)&lt;br&gt;owner fixes the form" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1360" y="175" width="130" height="55" as="geometry"/></mxCell><mxCell id="c23" value="Create &lt;i&gt;contributor&lt;/i&gt; account (if new) + listing&lt;br&gt;post_status=&lt;b&gt;pending&lt;/b&gt;, _pk_status=&lt;b&gt;en_attente_whatsapp&lt;/b&gt;&lt;br&gt;photos → AVIF · FR/EN/AR variants · code PK-id-XXXXXXX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1500" y="335" width="300" height="85" as="geometry"/></mxCell><mxCell id="c24" value="Place request stored&lt;br&gt;listing &lt;b&gt;blocked&lt;/b&gt; (cannot publish)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1560" y="455" width="190" height="55" as="geometry"/></mxCell><mxCell id="c25" value="Confirmation screen with&lt;br&gt;wa.me link + code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1850" y="345" width="170" height="60" as="geometry"/></mxCell><mxCell id="c26" value="Opens WhatsApp and sends&lt;br&gt;the prefilled code message" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1850" y="175" width="180" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Team WhatsApp number&lt;br&gt;receives the code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1850" y="635" width="180" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Admin matches the code;&lt;br&gt;opens 'Valider les annonces'&lt;br&gt;(badge = pending count)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1840" y="800" width="200" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Place&lt;br&gt;pending?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1620" y="795" width="90" height="80" as="geometry"/></mxCell><mxCell id="c30" value="'Lieux proposés':&lt;br&gt;approve → term created &amp; attached&lt;br&gt;reject → listing stays blocked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="800" width="230" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Publish or&lt;br&gt;reject?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="795" width="100" height="80" as="geometry"/></mxCell><mxCell id="c32" value="Reject → post_status=draft,&lt;br&gt;_pk_status=&lt;b&gt;refuse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="810" width="200" height="55" as="geometry"/></mxCell><mxCell id="c33" value="Owner sees 'refusée'&lt;br&gt;(no owner action allowed)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shape=doubleEllipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="200" height="55" as="geometry"/></mxCell><mxCell id="c34" value="Approve → publish FR/EN/AR,&lt;br&gt;_pk_status=&lt;b&gt;actif&lt;/b&gt;, _pk_approved_at,&lt;br&gt;generate login + readable password&lt;br&gt;(only first time), purge cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="240" height="90" as="geometry"/></mxCell><mxCell id="c35" value="Alternative: editor meta box&lt;br&gt;'Valider WhatsApp' → publish&lt;br&gt;(no credentials sent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="915" width="210" height="60" as="geometry"/></mxCell><mxCell id="c36" value="POST webhook &lt;b&gt;listing_approved&lt;/b&gt;&lt;br&gt;(header X-Partikulier-Automation)&lt;br&gt;send_credentials = true / false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="240" height="80" as="geometry"/></mxCell><mxCell id="c37" value="n8n&lt;br&gt;reached?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="90" height="80" as="geometry"/></mxCell><mxCell id="c38" value="n8n catch-up:&lt;br&gt;GET /approved-listings (72 h)&lt;br&gt;never returns a password" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="625" width="200" height="70" as="geometry"/></mxCell><mxCell id="c39" value="WhatsApp message to owner:&lt;br&gt;login + password + login URL&lt;br&gt;(or 'votre annonce est en ligne')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="625" width="220" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Owner can log in&lt;br&gt;→ 'Mes annonces'" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shape=doubleEllipse;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="160" height="55" as="geometry"/></mxCell><mxCell id="c41" value="Lost password? Admin clicks&lt;br&gt;'Nouveau mot de passe'&lt;br&gt;→ new webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="915" width="200" height="60" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackground