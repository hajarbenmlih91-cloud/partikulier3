try"></mxGeometry></mxCell><mxCell id="c74" value="resend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;entryX=0;entryY=0.85;" edge="1" parent="1" source="c41" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="990"/><mxPoint x="830" y="990"/><mxPoint x="830" y="688"/></Array></mxGeometry></mxCell><mxCell id="c75" value="* Extra fields (charges, availability, year built, energy/GES class, lot size, half-baths, total rooms) are shown/hidden/required per property type from &lt;b&gt;Partikulier › Formulaire de dépôt&lt;/b&gt;; the server enforces the same rules." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1500" y="255" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. Listing lifecycle (states)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Listing lifecycle — WordPress post_status × business status _pk_status" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Owner actions go through one transition engine (Partikulier_Listing_Transitions) for both AJAX pk_manage_listing and REST /owner/listings/{id}/action. Only 'deactivate' and 'reactivate' are allowed." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="●" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Awaiting WhatsApp validation&lt;/b&gt;&lt;br&gt;post: pending&lt;br&gt;_pk_status: en_attente_whatsapp&lt;br&gt;&lt;i&gt;invisible publicly · owner: read-only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="160" y="290" width="230" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Blocked — place to validate&lt;/b&gt;&lt;br&gt;pending + _pk_place_pending&lt;br&gt;&lt;i&gt;any publish is forced back to pending&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="160" y="500" width="230" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Refused&lt;/b&gt;&lt;br&gt;post: draft · _pk_status: refuse&lt;br&gt;&lt;i&gt;owner cannot act (403)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="160" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Online&lt;/b&gt; (En ligne)&lt;br&gt;post: publish · _pk_status: actif / ''&lt;br&gt;&lt;i&gt;in search, contact enabled, FR/EN/AR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="250" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Deactivated&lt;/b&gt;&lt;br&gt;post: publish · _pk_status: vendu | loue | indisponible&lt;br&gt;&lt;i&gt;page stays public (SEO) with badge,&lt;br&gt;hidden from lists, contact OFF,&lt;br&gt;similar listings shown&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="280" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Trash&lt;/b&gt;&lt;br&gt;EN/AR variants trashed too&lt;br&gt;&lt;i&gt;restore by team only&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="220" height="80" as="geometry"/></mxCell><mxCell id="c10" value="owner submits&lt;br&gt;deposit form" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="admin 'Publier'&lt;br&gt;or 'Valider WhatsApp'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="admin 'Refuser'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="proposed place" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="place approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="545"/><mxPoint x="140" y="380"/></Array></mxGeometry></mxCell><mxCell id="c15" value="owner 'Désactiver' + reason&lt;br&gt;(vendu / loué / avis / autre)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="260"/><mxPoint x="1120" y="260"/></Array></mxGeometry></mxCell><mxCell id="c16" value="owner 'Réactiver' (reopen)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="440"/><mxPoint x="690" y="440"/></Array></mxGeometry></mxCell><mxCell id="c17" value="change reason (motif_change)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="345"/><mxPoint x="1290" y="250"/><mxPoint x="1200" y="250"/></Array></mxGeometry></mxCell><mxCell id="c18" value="owner 'Modifier' → re-submit&lt;br&gt;(re-moderation + new code)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="230"/><mxPoint x="330" y="230"/></Array></mxGeometry></mxCell><mxCell id="c19" value="admin trash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="admin trash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="580"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Owner action matrix (server-side)&lt;/b&gt;&lt;br&gt;• refuse / en_attente_whatsapp → 403 (distinct messages)&lt;br&gt;• not published → 403 (reactivation only by team)&lt;br&gt;• unknown status → 403 (team must arbitrate)&lt;br&gt;• retired actions mark_sold, mark_rented, pause, archive, delete → 400&lt;br&gt;• reactivate on an online listing → 200 idempotent (resume)&lt;br&gt;• writes are compare-write-verify, propagated to variants, cache purged; partial failure → 500 with step report" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="470" width="420" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Premium (independent of availability)&lt;/b&gt;" style="text;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="680" width="300" height="30" as="geometry"/></mxCell><mxCell id="c23" value="none" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="160" y="720" width="90" height="40" as="geometry"/></mxCell><mxCell id="c24" value="active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="720" width="90" height="40" as="geometry"/></mxCell><mxCell id="c25" value="expired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="c26" value="revoked" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="90" height="40" as="geometry"/></mxCell><mxCell id="c27" value="admin grant" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="end date" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="admin revoke" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Publicly visible only if flag pk_premium_public_enabled ∧ active ∧ listing available (premium-first sort). Payments/alerts: foundations only, disabled." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4. Buyer journey &amp; WhatsApp contact"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Workflow 2 — Visitor searches, saves favourites and contacts an owner through WhatsApp + n8n" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="The site never shows the owner phone; the buyer gets it on WhatsApp only after server-side authorization (LeadService::authorize_contact)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="2300" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Visitor / Buyer" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="40" height="190" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="2440" height="190" as="geometry"/></mxCell><mxCell id="c5" value="Website" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="40" height="190" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="2440" height="190" as="geometry"/></mxCell><mxCell id="c7" value="WhatsApp + n8n" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="40" height="190" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="2440" height="190" as="geometry"/></mxCell><mxCell id="c9" value="REST API (plugin)" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="40" height="190" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="2440" heigh