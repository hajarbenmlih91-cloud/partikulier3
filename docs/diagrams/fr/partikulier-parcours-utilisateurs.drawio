)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="renvoyer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;entryX=0;entryY=0.85;" edge="1" parent="1" source="c41" target="c36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="990"/><mxPoint x="830" y="990"/><mxPoint x="830" y="688"/></Array></mxGeometry></mxCell><mxCell id="c75" value="* Les champs extra (charges, disponibilité, année de construction, classe énergie/GES, surface du terrain, demi-salles de bain, nombre total de pièces) sont affichés/masqués/obligatoires par type de bien depuis &lt;b&gt;Partikulier › Formulaire de dépôt&lt;/b&gt; ; le serveur applique les mêmes règles." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1500" y="255" width="520" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. Cycle de vie d'une annonce"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Cycle de vie d'une annonce — post_status WordPress × statut métier _pk_status" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Les actions propriétaire passent par un moteur de transition unique (Partikulier_Listing_Transitions), à la fois pour AJAX pk_manage_listing et REST /owner/listings/{id}/action. Seuls 'deactivate' et 'reactivate' sont autorisés." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="●" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="30" height="30" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;En attente de validation WhatsApp&lt;/b&gt;&lt;br&gt;post: pending&lt;br&gt;_pk_status: en_attente_whatsapp&lt;br&gt;&lt;i&gt;invisible publiquement · propriétaire : lecture seule&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="160" y="290" width="230" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Bloquée — lieu à valider&lt;/b&gt;&lt;br&gt;pending + _pk_place_pending&lt;br&gt;&lt;i&gt;toute publication est forcée à pending&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="160" y="500" width="230" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Refusée&lt;/b&gt;&lt;br&gt;post: draft · _pk_status: refuse&lt;br&gt;&lt;i&gt;le propriétaire ne peut pas agir (403)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="160" y="110" width="230" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;En ligne&lt;/b&gt;&lt;br&gt;post: publish · _pk_status: actif / ''&lt;br&gt;&lt;i&gt;dans la recherche, contact actif, FR/EN/AR&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="250" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Désactivée&lt;/b&gt;&lt;br&gt;post: publish · _pk_status: vendu | loue | indisponible&lt;br&gt;&lt;i&gt;page publique (SEO) avec badge,&lt;br&gt;absente des listes, contact OFF,&lt;br&gt;annonces similaires affichées&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="980" y="280" width="280" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Corbeille&lt;/b&gt;&lt;br&gt;variantes EN/AR aussi supprimées&lt;br&gt;&lt;i&gt;restauration par l'équipe uniquement&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="580" y="540" width="220" height="80" as="geometry"/></mxCell><mxCell id="c10" value="dépôt&lt;br&gt;soumis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="admin 'Publier'&lt;br&gt;ou 'Valider WhatsApp'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="admin 'Refuser'" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="lieu proposé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="lieu approuvé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="545"/><mxPoint x="140" y="380"/></Array></mxGeometry></mxCell><mxCell id="c15" value="propriétaire 'Désactiver' + motif&lt;br&gt;(vendu / loué / avis / autre)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="260"/><mxPoint x="1120" y="260"/></Array></mxGeometry></mxCell><mxCell id="c16" value="propriétaire 'Réactiver' (remettre en ligne)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="440"/><mxPoint x="690" y="440"/></Array></mxGeometry></mxCell><mxCell id="c17" value="changer le motif (motif_change)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="345"/><mxPoint x="1290" y="250"/><mxPoint x="1200" y="250"/></Array></mxGeometry></mxCell><mxCell id="c18" value="propriétaire 'Modifier' → resoumettre&lt;br&gt;(nouvelle modération + nouveau code)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="230"/><mxPoint x="330" y="230"/></Array></mxGeometry></mxCell><mxCell id="c19" value="admin met à la corbeille" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="admin met à la corbeille" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="580"/></Array></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Matrice des actions propriétaire (côté serveur)&lt;/b&gt;&lt;br&gt;• refuse / en_attente_whatsapp → 403 (messages distincts)&lt;br&gt;• non publiée → 403 (réactivation par l'équipe uniquement)&lt;br&gt;• statut inconnu → 403 (arbitrage par l'équipe)&lt;br&gt;• actions retirées mark_sold, mark_rented, pause, archive, delete → 400&lt;br&gt;• reactivate sur une annonce en ligne → 200 idempotent (reprise)&lt;br&gt;• écritures compare-write-verify, propagées aux variantes, cache purgé ; échec partiel → 500 avec rapport d'étape" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="980" y="470" width="420" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Premium (indépendant de la disponibilité)&lt;/b&gt;" style="text;html=1;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="680" width="300" height="30" as="geometry"/></mxCell><mxCell id="c23" value="aucun" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="160" y="720" width="90" height="40" as="geometry"/></mxCell><mxCell id="c24" value="actif" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="720" width="90" height="40" as="geometry"/></mxCell><mxCell id="c25" value="expiré" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="90" height="40" as="geometry"/></mxCell><mxCell id="c26" value="révoqué" style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="760" width="90" height="40" as="geometry"/></mxCell><mxCell id="c27" value="attribution admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="date de fin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="retrait admin" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Visible publiquement uniquement si le drapeau pk_premium_public_enabled ∧ actif ∧ annonce disponible (tri premium en premier). Paiements/alertes : fondations seulement, désactivés." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="700" width="420" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4. Parcours acheteur et contact WhatsApp"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Parcours 2 — Le visiteur recherche, enregistre des favoris et contacte un propriétaire via WhatsApp + n8n" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Le site n'affiche jamais le téléphone du propriétaire ; l'acheteur le reçoit sur WhatsApp uniquement après autorisation côté serveur (LeadService::authorize_contact)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="2300" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Visiteur / Acheteur" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="40" height="190" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="2440" height="190" as="geometry"/></mxCell><mxCell id="c5" value="Site" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="40" height="190" as="geometry"/></mxCell><mxCell id="c6" value="" style="roun