<mxfile host="app.diagrams.net" agent="partikulier-docs" version="24.0.0"><diagram id="page1" name="1. Acteurs et cas d'usage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Partikulier — acteurs et cas d'usage" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Portail immobilier marocain réservé aux particuliers propriétaires. Qui peut faire quoi sur le site (thème 'partikulier' + extension 'partikulier-core' + Estatik + Polylang optionnel)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="1600" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Site Partikulier (WordPress)" style="rounded=0;html=1;verticalAlign=top;fontStyle=1;fontSize=14;dashed=1;fillColor=#ffffff;strokeColor=#999999;fillColor=none;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="1000" height="900" as="geometry"/></mxCell><mxCell id="c4" value="A. Consultation publique (sans compte)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="130" width="470" height="330" as="geometry"/></mxCell><mxCell id="c5" value="B. Parcours propriétaire (dépôt + espace propriétaire)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="470" height="330" as="geometry"/></mxCell><mxCell id="c6" value="C. Back-office (manage_options)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="480" width="470" height="490" as="geometry"/></mxCell><mxCell id="c7" value="D. API d'automatisation (en-tête secret X-Partikulier-Automation)" style="rounded=1;html=1;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="810" y="480" width="470" height="490" as="geometry"/></mxCell><mxCell id="c8" value="Rechercher et filtrer les annonces&lt;br&gt;(Vendre/Louer, type, ville, prix max., tri)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c9" value="Consulter une annonce&lt;br&gt;/annonce/ville/quartier/slug" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c10" value="Changer de langue FR / EN / AR" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c11" value="Ajouter / retirer des favoris ♥&lt;br&gt;(stockés dans le navigateur)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c12" value="Consulter la page 'Mes favoris'" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c13" value="Contacter le propriétaire via WhatsApp&lt;br&gt;(référence PK-123-ABCD)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c14" value="Voir une annonce clôturée (Vendu/Loué)&lt;br&gt;+ annonces similaires" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c15" value="Demander des biens similaires à l'équipe&lt;br&gt;(WhatsApp prérempli)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c16" value="Déposer une annonce en 3 étapes&lt;br&gt;(aucun compte requis)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c17" value="Proposer une ville / un quartier manquant" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="165" width="210" height="52" as="geometry"/></mxCell><mxCell id="c18" value="Valider le dépôt par code WhatsApp&lt;br&gt;PK-&amp;lt;id&amp;gt;-XXXXXXX" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c19" value="Recevoir l'identifiant + mot de passe&lt;br&gt;sur WhatsApp (n8n)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="229" width="210" height="52" as="geometry"/></mxCell><mxCell id="c20" value="Se connecter → tableau de bord 'Mes annonces'&lt;br&gt;(vues, favoris, KPIs)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c21" value="Modifier une annonce&lt;br&gt;(→ retour en modération)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="293" width="210" height="52" as="geometry"/></mxCell><mxCell id="c22" value="Désactiver avec un motif&lt;br&gt;(vendu / loué / avis / autre)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c23" value="Réactiver une annonce désactivée" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="357" width="210" height="52" as="geometry"/></mxCell><mxCell id="c24" value="Approuver / refuser les annonces en attente&lt;br&gt;(Valider les annonces)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c25" value="Marquer le code WhatsApp comme vérifié&lt;br&gt;(méta-box de l'éditeur)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c26" value="Régénérer et renvoyer le mot de passe&lt;br&gt;('Nouveau mot de passe')" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c27" value="Modérer les lieux proposés&lt;br&gt;(Lieux proposés)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c28" value="Importer / réinitialiser les villes et quartiers" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c29" value="Configurer les champs du formulaire de dépôt&lt;br&gt;par type de bien" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c30" value="Personnaliser les textes, le numéro WhatsApp,&lt;br&gt;l'URL webhook n8n et le secret" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c31" value="Suivre les leads WhatsApp&lt;br&gt;(statut, note, export CSV)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c32" value="Attribuer / retirer le premium&lt;br&gt;(affichage public désactivé par défaut)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c33" value="Lancer le diagnostic des pages&lt;br&gt;et l'assistant de mise à niveau" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c34" value="Mettre à la corbeille / restaurer les annonces&lt;br&gt;(variantes synchronisées)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="335" y="835" width="210" height="52" as="geometry"/></mxCell><mxCell id="c35" value="Vérifier l'endpoint /health" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="565" y="835" width="210" height="52" as="geometry"/></mxCell><mxCell id="c36" value="Recevoir le webhook 'listing_approved'&lt;br&gt;→ envoyer les identifiants" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c37" value="Rattrapage : GET /approved-listings&lt;br&gt;(72 h, jamais de mot de passe)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="515" width="210" height="52" as="geometry"/></mxCell><mxCell id="c38" value="POST /contact-authorization&lt;br&gt;(max. 2 propriétaires distincts / jour)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c39" value="POST /preferences&lt;br&gt;(budget, secteurs, agencement)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="579" width="210" height="52" as="geometry"/></mxCell><mxCell id="c40" value="POST /consent&lt;br&gt;(annonces similaires, OUI explicite)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c41" value="POST /opt-out ('STOP')" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="643" width="210" height="52" as="geometry"/></mxCell><mxCell id="c42" value="POST /automation-event" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c43" value="POST /erase-lead (RGPD,&lt;br&gt;secret dédié)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="707" width="210" height="52" as="geometry"/></mxCell><mxCell id="c44" value="Purge de conservation des leads&lt;br&gt;(365 jours par défaut)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="825" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c45" value="Comptage anonyme des favoris&lt;br&gt;(HMAC, 90 jours)" style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1055" y="771" width="210" height="52" as="geometry"/></mxCell><mxCell id="c46" value="Visiteur / Acheteur&lt;br&gt;(anonyme)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="40" height="70" as="geometry"/></mxCell><mxCell id="c47" value="Moteurs de recherche&lt;br&gt;(sitemap, JSON-LD)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="360" width="40" height="70" as="geometry"/></mxCell><mxCell id="c48" value="Administrateur&lt;br&gt;(manage_options)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="140" y="690" width="40" height="70" as="geometry"/></mxCell><mxCell id="c49" value="Propriétaire&lt;br&gt;(déposant anonyme)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="150" width="40" height="70" as="geometry"/></mxCell><mxCell id="c50" value="Propriétaire inscrit&lt;br&gt;(compte contributor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="290" width="40" height="70" as="geometry"/></mxCell><mxCell id="c51" value="Agent / agence&lt;br&gt;(REFUSÉ)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1600" y="220" width="40" height="70" as="geometry"/></mxCell><mxCell id="c52" value="orchestrateur n8n&lt;br&gt;(acteur système)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="c53" value="WhatsApp Business&lt;br&gt;Cloud (Meta)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1600" y="620" width="40" height="70" as="geometry"/></mxCell><mxCell id="c54" value="Client API&lt;br&gt;(éditeur connecté)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=11;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="820" width="40" height="70" as="geometry"/></mxCell><mxCell id="c55" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c46" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="indexation" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c47" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c48" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c49" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c50" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="refusé" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#b85450;fontColor=#b85450;dashed=1;" edge="1" parent="1" source="c51" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="255"/><mxPoint x="1560" y="120"/><mxPoint x="1045" y="120"/></Array></mxGeometry></mxCell><mxCell id="c61" value="" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c52" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c53" target="c52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="/listings, /favorites" style="endArrow=none;html=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c54" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;Types d'utilisateurs (synthèse)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Visiteur / Acheteur&lt;/b&gt; : anonyme ; consulte, met en favoris (navigateur uniquement), contacte via WhatsApp — ne crée jamais de compte.&lt;br&gt;• &lt;b&gt;Propriétaire (déposant anonyme)&lt;/b&gt; : dépose sans compte ; un compte WordPress &lt;i&gt;contributor&lt;/i&gt; est créé silencieusement.&lt;br&gt;• &lt;b&gt;Propriétaire inscrit&lt;/b&gt; : même personne après validation admin ; reçoit identifiant/mot de passe sur WhatsApp, gère ses annonces.&lt;br&gt;• &lt;b&gt;Agent / agence&lt;/b&gt; : explicitement refusé (côté client et serveur) — portail réservé aux propriétaires, zéro commission.&lt;br&gt;• &lt;b&gt;Administrateur&lt;/b&gt; : modère annonces, lieux, leads, premium, réglages.&lt;br&gt;• &lt;b&gt;Acteurs système&lt;/b&gt; : n8n + WhatsApp Cloud API (en-tête secret), clients API REST, moteurs de recherche." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="1000" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Dépôt propriétaire et validation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Parcours 1 — Le propriétaire dépose une annonce, valide par WhatsApp, l'admin approuve" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="2300" height="36" as="geometry"/></mxCell><mxCell id="c2" value="Page /deposer-une-annonce (templates/page-deposer-annonce.php → AJAX pk_submit_listing → Partikulier_Form::process), puis Partikulier › Valider les annonces (Partikulier_Listing_Approval)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="46" width="2300" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Propriétaire" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="40" height="230" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c5" value="Site (thème + extension)" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="40" height="230" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c7" value="WhatsApp / n8n" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="20" y="550" width="40" height="230" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c9" value="Administrateur" style="rounded=0;html=1;horizontal=0;fontStyle=1;fontSize=12;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="40" height="230" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#999999;fillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="2340" height="230" as="geometry"/></mxCell><mxCell id="c11" value="Clique sur&lt;br&gt;'Déposer une annonce'" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="175" width="110" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Étape 1&lt;/b&gt; — Qui publie ?&lt;br&gt;Propriétaire / Agent immobilier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="175" width="170" height="60" as="geometry"/></mxCell><mxCell id="c13" value="Agent ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="80" height="70" as="geometry"/></mxCell><mxCell id="c14" value="Refus : 'Ce site est réservé aux propriétaires'&lt;br&gt;(JS + serveur : WP_Error role_agent)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="200" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Étape 1 (suite) — Vendre / Louer,&lt;br&gt;type de bien, ville + quartier&lt;br&gt;(autocomplétion)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="530" y="170" width="180" height="70" as="geometry"/></mxCell><mxCell id="c16" value="Lieu dans&lt;br&gt;la liste ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="80" height="70" as="geometry"/></mxCell><mxCell id="c17" value="'Je ne trouve pas ma ville'&lt;br&gt;→ proposer ville / quartier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="180" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Étape 2&lt;/b&gt; — surface, chambres, salles de bain,&lt;br&gt;prix, étage, garage, ascenseur, terrasse,&lt;br&gt;ensoleillement, champs extra*, photos (≤15, ≤10 Mo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="165" width="220" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Étape 3&lt;/b&gt; — aperçu, titre auto (modifiable),&lt;br&gt;note personnelle, nom, téléphone*, e-mail (opt.)&lt;br&gt;→ 'Valider avec WhatsApp'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="165" width="230" height="80" as="geometry"/></mxCell><mxCell id="c20" value="Contrôles serveur : nonce · clé d'idempotence&lt;br&gt;(pas de double envoi) · limite de débit (429) ·&lt;br&gt;règles de champs · numéro WhatsApp configuré" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="340" width="230" height="75" as="geometry"/></mxCell><mxCell id="c21" value="Valide ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1380" y="340" width="80" height="70" as="geometry"/></mxCell><mxCell id="c22" value="Message d'erreur (400)&lt;br&gt;le propriétaire corrige le formulaire" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1360" y="175" width="130" height="55" as="geometry"/></mxCell><mxCell id="c23" value="Créer un compte &lt;i&gt;contributor&lt;/i&gt; (si nouveau) + annonce&lt;br&gt;post_status=&lt;b&gt;pending&lt;/b&gt;, _pk_status=&lt;b&gt;en_attente_whatsapp&lt;/b&gt;&lt;br&gt;photos → AVIF · variantes FR/EN/AR · code PK-id-XXXXXXX" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1500" y="335" width="300" height="85" as="geometry"/></mxCell><mxCell id="c24" value="Demande de lieu enregistrée&lt;br&gt;annonce &lt;b&gt;bloquée&lt;/b&gt; (publication impossible)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1560" y="455" width="190" height="55" as="geometry"/></mxCell><mxCell id="c25" value="Écran de confirmation avec&lt;br&gt;lien wa.me + code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1850" y="345" width="170" height="60" as="geometry"/></mxCell><mxCell id="c26" value="Ouvre WhatsApp et envoie&lt;br&gt;le message de code prérempli" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1850" y="175" width="180" height="60" as="geometry"/></mxCell><mxCell id="c27" value="Le numéro WhatsApp de l'équipe&lt;br&gt;reçoit le code" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1850" y="635" width="180" height="60" as="geometry"/></mxCell><mxCell id="c28" value="L'admin rapproche le code ;&lt;br&gt;ouvre 'Valider les annonces'&lt;br&gt;(badge = nombre en attente)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1840" y="800" width="200" height="70" as="geometry"/></mxCell><mxCell id="c29" value="Lieu&lt;br&gt;en attente ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1620" y="795" width="90" height="80" as="geometry"/></mxCell><mxCell id="c30" value="'Lieux proposés' :&lt;br&gt;valider → terme créé et attaché&lt;br&gt;refuser → annonce toujours bloquée" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1340" y="800" width="230" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Publier ou&lt;br&gt;refuser ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1150" y="795" width="100" height="80" as="geometry"/></mxCell><mxCell id="c32" value="Refuser → post_status=draft,&lt;br&gt;_pk_status=&lt;b&gt;refuse&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="880" y="810" width="200" height="55" as="geometry"/></mxCell><mxCell id="c33" value="Le propriétaire voit 'refusée'&lt;br&gt;(aucune action propriétaire autorisée)" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shape=doubleEllipse;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="810" width="200" height="55" as="geometry"/></mxCell><mxCell id="c34" value="Approuver → publier FR/EN/AR,&lt;br&gt;_pk_status=&lt;b&gt;actif&lt;/b&gt;, _pk_approved_at,&lt;br&gt;générer identifiant + mot de passe lisible&lt;br&gt;(première fois seulement), purger le cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="440" width="240" height="90" as="geometry"/></mxCell><mxCell id="c35" value="Alternative : méta-box éditeur&lt;br&gt;'Valider WhatsApp' → publier&lt;br&gt;(aucun identifiant envoyé)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1150" y="915" width="210" height="60" as="geometry"/></mxCell><mxCell id="c36" value="POST webhook &lt;b&gt;listing_approved&lt;/b&gt;&lt;br&gt;(en-tête X-Partikulier-Automation)&lt;br&gt;send_credentials = true / false" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="240" height="80" as="geometry"/></mxCell><mxCell id="c37" value="n8n&lt;br&gt;joignable ?" style="rhombus;whiteSpace=wrap;html=1;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="620" y="620" width="90" height="80" as="geometry"/></mxCell><mxCell id="c38" value="Rattrapage n8n :&lt;br&gt;GET /approved-listings (72 h)&lt;br&gt;ne renvoie jamais de mot de passe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="380" y="625" width="200" height="70" as="geometry"/></mxCell><mxCell id="c39" value="Message WhatsApp au propriétaire :&lt;br&gt;identifiant + mot de passe + URL de connexion&lt;br&gt;(ou 'votre annonce est en ligne')" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="120" y="625" width="220" height="70" as="geometry"/></mxCell><mxCell id="c40" value="Le propriétaire peut se connecter&lt;br&gt;→ 'Mes annonces'" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;shape=doubleEllipse;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="160" height="55" as="geometry"/></mxCell><mxCell id="c41" value="Mot de passe perdu ? L'admin clique&lt;br&gt;'Nouveau mot de passe'&lt;br&gt;→ nouveau webhook" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="380" y="915" width="200" height="60" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="oui" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="non" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundC