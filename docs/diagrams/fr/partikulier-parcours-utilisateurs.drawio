ml=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Admin WordPress&lt;/b&gt;&lt;br&gt;menu Partikulier" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="380" width="220" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Valider les annonces&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Lister les annonces en attente (hors traductions auto) · Publier · Refuser · 'Nouveau mot de passe' (renvoi via n8n) · notice d'identifiants chiffrée à usage unique (5 min)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="340" height="100" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;Lieux proposés&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Ville/quartier proposé par le propriétaire : Valider (crée le terme, débloque l'annonce) · Refuser (l'annonce reste bloquée)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="340" height="100" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="&lt;b&gt;Villes &amp; quartiers&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Importer ou réinitialiser le référentiel des lieux marocains (villes/quartiers, noms FR/AR)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="340" height="100" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Formulaire de dépôt&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Par type de bien : chaque champ optionnel Masqué / Optionnel / Obligatoire, avec plafond d'affichage ; appliqué côté serveur&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="340" height="100" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Personnalisation du site&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Personnalisation du site sans code (textes, sections, visuels)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="340" height="100" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Annonces premium&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Attribuer / retirer un emplacement premium avec motif et dates ; journal d'historique ; drapeau de visibilité publique désactivé jusqu'aux règles métier G3&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="340" height="100" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Leads WhatsApp (niveau principal)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;KPIs, filtres (statut, consentement, référence), statut de suivi + note, export CSV, STOP affiché séparément&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1160" y="300" width="340" height="100" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Diagnostic des pages&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Analyse 6 pages clés (accueil, archive, dépôt, Mes annonces, favoris, dernière annonce) et répare les pages requises&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1160" y="460" width="340" height="100" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Mise à niveau&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Assistant de mise à niveau : corriger la taxonomie des villes, réassigner À vendre / À louer, créer les versions AR et EN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="340" height="100" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Customizer › Validation WhatsApp&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;Numéro de validation (obligatoire, sinon dépôts refusés), modèle de message ({code},{titre},{ville},{prix},{lien},{nom}), numéro acheteur, URL webhook n8n, secret API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="20" y="460" width="340" height="100" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="c2" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Également dans l'éditeur d'annonce : méta-box 'Validation WhatsApp' → marquer le code vérifié et publier (aucun identifiant envoyé)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="560" y="790" width="440" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="7. Carte système et API"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Contexte système et points d'entrée (namespace partikulier/v1)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="36" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Navigateur&lt;/b&gt;&lt;br&gt;visiteur · propriétaire · admin" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;WordPress&lt;/b&gt;&lt;br&gt;thème partikulier (UI, formulaires, SEO, cache, AVIF, i18n)&lt;br&gt;extension partikulier-core (domaines, REST, migrations, santé)&lt;br&gt;Estatik (CPT 'properties') · Polylang (FR/EN/AR)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="420" height="140" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;n8n&lt;/b&gt;&lt;br&gt;orchestration uniquement" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="150" width="180" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;WhatsApp Business&lt;br&gt;Cloud API (Meta)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1400" y="150" width="180" height="80" as="geometry"/></mxCell><mxCell id="c6" value="MySQL : wp_posts / postmeta (_pk_*) +&lt;br&gt;pk_buyer_leads, pk_contact_limits, pk_contact_disclosures,&lt;br&gt;pk_whatsapp_messages, pk_property_saves, pk_premium_history,&lt;br&gt;pk_saved_alerts, pk_payment_orders, pk_idempotency, journal d'audit" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="420" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Pages HTTPS + AJAX/REST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="webhook listing_approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="REST + X-Partikulier-Automation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="290"/><mxPoint x="630" y="290"/></Array></mxGeometry></mxCell><mxCell id="c10" value="envoyer / recevoir" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="liens profonds wa.me (code propriétaire, réf. acheteur)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="80"/><mxPoint x="1490" y="80"/></Array></mxGeometry></mxCell><mxCell id="c13" value="&lt;b&gt;Public (limité en débit)&lt;/b&gt;&lt;br&gt;GET /listings · GET /listings/{id} · GET /health (180/min)&lt;br&gt;POST /leads (10/min)&lt;br&gt;&lt;br&gt;&lt;b&gt;Connecté&lt;/b&gt;&lt;br&gt;POST /listings (editor, 30/min) · POST /favorites&lt;br&gt;GET /owner/dashboard · POST /owner/listings/{id}/action (cookie + nonce)&lt;br&gt;&lt;br&gt;&lt;b&gt;Secret d'automatisation&lt;/b&gt;&lt;br&gt;POST /contact-authorization · /preferences · /consent · /opt-out · /automation-event&lt;br&gt;GET /approved-listings (72 h) · accusé de renvoi&lt;br&gt;POST /erase-lead (secret dédié + anti-bruteforce)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="560" height="230" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;AJAX (admin-ajax.php)&lt;/b&gt;&lt;br&gt;pk_submit_listing (nopriv) · pk_manage_listing · pk_sync_favorite · pk_favorites_list · pk_views_counter · aperçu d'annonce · autocomplétion des lieux&lt;br&gt;&lt;br&gt;&lt;b&gt;actions admin-post&lt;/b&gt;&lt;br&gt;pk_approve_listing · pk_resend_credentials · pk_verify_whatsapp · pk_place_decision · pk_places_import/reset · pk_grant/revoke_premium · pk_update_lead_followup · pk_export_leads · pk_save_customization · pk_save_n8n_settings" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingTop=6;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="560" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
