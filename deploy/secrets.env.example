# Hostinger deploy secrets — template (tracked). Never put real values here.
# Copy to deploy/secrets/<env>.env (git-ignored), one file per GitHub environment: dev, uat, prd.
#
# Upload to the matching GitHub environment (requires GitHub CLI `gh`):
#   gh secret set --env uat -f deploy/secrets/uat.env
#   Get-Content "$HOME\.ssh\partikulier-uat" -Raw | gh secret set SSH_PRIVATE_KEY --env uat   (PowerShell)
#   gh secret set SSH_PRIVATE_KEY --env uat < "%USERPROFILE%\.ssh\partikulier-uat"   (cmd)
#   gh variable set SITE_URL --env uat --body "https://uat.example.com"
#
# Only single-line KEY=value secrets belong below; the private key is uploaded from its file.

SSH_HOST=CHANGE_ME_HOST_OR_IP
SSH_PORT=65002
SSH_USER=CHANGE_ME_u123456789
# One line from: ssh-keyscan -p 65002 -t ed25519 <host>
SSH_KNOWN_HOSTS="CHANGE_ME [host]:65002 ssh-ed25519 AAAA..."
WP_PATH=/home/CHANGE_ME_u123456789/domains/CHANGE_ME_DOMAIN/public_html

# Not a secret — GitHub environment variable, set with `gh variable set` (see above).
# SITE_URL=https://CHANGE_ME_DOMAIN
# SSH private key file (local path, never committed): ~/.ssh/partikulier-<env>
