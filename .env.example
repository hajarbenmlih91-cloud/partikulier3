# Copy to .env (git-ignored) and replace every value. Local use only.
PK_DB_NAME=partikulier
PK_DB_USER=partikulier
PK_DB_PASSWORD=change-me-db
PK_DB_ROOT_PASSWORD=change-me-root
PK_ADMIN_USER=admin
PK_ADMIN_PASSWORD=change-me-admin
PK_ADMIN_EMAIL=admin@example.test

# 1 = install Polylang 3.8.7 (FR/EN/AR front) ; 1 = build avifenc/vips into the image
PK_WITH_POLYLANG=0
PK_WITH_AVIF_TOOLS=0
PK_WP_IMAGE_TAG=6.6-php8.3-apache

# Optional n8n bridge — generate with: openssl rand -base64 48
PARTIKULIER_N8N_SECRET=
PARTIKULIER_N8N_WEBHOOK_URL=
